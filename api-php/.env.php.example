<?php
/**
 * 環境変数設定ファイル（XServer用）
 * このファイルを .env.php として with-sasayama/ 直下に置いてください
 * 絶対に公開ディレクトリに置かないこと（public_html の外に置くのが理想）
 * .htaccess で Deny from all を設定すること
 */

// ========== microCMS 設定 ==========
// microCMS管理画面の「サービスID」を設定（例: your-service）
define('MICROCMS_SERVICE_DOMAIN', 'YOUR_SERVICE_DOMAIN_HERE');

// microCMS 書き込み可能APIキー（API設定 > APIキーから取得）
define('MICROCMS_API_KEY', 'YOUR_MICROCMS_API_KEY_HERE');

// microCMS マネジメントAPIキー（画像アップロード・メディア管理に使用）
define('MICROCMS_MANAGEMENT_KEY', 'YOUR_MICROCMS_MANAGEMENT_KEY_HERE');

// ========== 管理画面 Basic認証 ==========
define('ADMIN_USER', 'admin');
define('ADMIN_PASS', 'YOUR_STRONG_PASSWORD_HERE');

// ========== Gemini API ==========
define('GEMINI_API_KEY', 'YOUR_GEMINI_API_KEY_HERE');

// ========== Discord Webhook 通知 ==========
// Discordサーバー > チャンネル設定 > 連携サービス > ウェブフック から取得
// 例: https://discord.com/api/webhooks/XXXXXXXXXX/YYYYYYYY
define('DISCORD_WEBHOOK_URL', 'YOUR_DISCORD_WEBHOOK_URL_HERE');

// エラー・警告ログを自動でDiscordに通知するか（1=有効, 0=無効）
// 有効にすると error/warn レベルのログ記録時に自動通知される
define('DISCORD_AUTO_NOTIFY', '0');
